# Example environment values for local/dev use
# Copy to .env and replace placeholders

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# CORS (comma-separated origins). Leave empty to use built-in defaults.
ALLOWED_ORIGINS=

# Email (optional)
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_RECIPIENTS=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
BUG_REPORT_RECIPIENT=colin.buchheit@beartechs.com