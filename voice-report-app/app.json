{
  "expo": {
    "name": "BEAR S&T Voice",
    "slug": "voice-report-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appicon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#101214"
      }
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "BEAR S&T Voice",
        "NSMicrophoneUsageDescription": "Allow Voice Report App to access the microphone to record voice notes and generate summaries.",
        "NSPhotoLibraryUsageDescription": "Allow Voice Report App to access your photo library to attach screenshots to feedback emails."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/appicon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.beartechs.voicereport",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#101214",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#101214",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d494af9e-4a50-40f5-8022-434a11074f11"
      }
    }
  }
}
